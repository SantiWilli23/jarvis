{
  "name": "jarvis-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Jarvis para Windows: orbe flotante, bandeja, atajo global y runner de Claude Code",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis"
  },
  "build": {
    "appId": "local.jarvis.desktop",
    "productName": "Jarvis",
    "files": [
      "main.js",
      "lib/**",
      "runner/**",
      "browser/**",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false
    }
  },
  "devDependencies": {
    "electron": "^45.3.2",
    "electron-builder": "^26.18.0"
  }
}
