{
  "nota": "Modo Pro: modelos, límites y tiempos. Motor lógico \"gemini\" = Antigravity CLI (agy) con la sesión iniciada en el PC. Contrato: docs/PRO.md.",
  "modelos": {
    "claude": {
      "planear": "opus",
      "programar": "sonnet",
      "verificar": "opus"
    },
    "gemini": {
      "planear": "gemini-3.8-flash-high",
      "verificar": "gemini-3.8-flash-high",
      "programar": [
        "gemini-3.8-flash-high",
        "gemini-3.8-flash-medium",
        "gemini-3.8-flash-low"
      ],
      "programar_baja_solo_por": [
        503
      ],
      "nota": "Modelos de agy (compruebe con `agy models`). gemini-4-hydrogen se permite pero NO aparece en agy: planea por la API (config/providers.json motores_pc.gemini.planificador)."
    },
    "prohibidos": [
      "gemini-2.5-pro",
      "*flash-lite*",
      "gemini-4-argon",
      "gemini-4-carbon",
      "gemini-3.1-pro*"
    ],
    "permitidos": [
      "gemini-4-hydrogen",
      "gemini-3.8-flash",
      "gemini-3.8-flash-*"
    ]
  },
  "limites": {
    "correcciones_max": 2,
    "informe_max_caracteres": 20000,
    "diff_max_caracteres": 200000,
    "mensaje_max_caracteres": 8000
  },
  "timeouts": {
    "planear_s": 300,
    "programar_s": 1800,
    "verificar_s": 300,
    "job_reclamado_s": 60,
    "pc_en_linea_s": 45
  },
  "requisitos": {
    "claude_modelos": [
      "opus",
      "sonnet"
    ],
    "gemini_login": null,
    "repos_git": true,
    "gemini_cli_min": "1.1.1"
  }
}
