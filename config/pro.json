{
  "nota": "Modo Pro: modelos, límites y tiempos. Motor lógico 'gemini' = Antigravity CLI (agy) con login Google AI Pro. Contrato: docs/PRO.md.",
  "modelos": {
    "claude": {
      "planear": "opus",
      "programar": "sonnet",
      "verificar": "opus"
    },
    "gemini": {
      "planear": "gemini-3.8-flash-high",
      "verificar": "gemini-3.8-flash-high",
      "programar": [
        "gemini-3.8-flash-medium",
        "gemini-3.8-flash-low"
      ],
      "programar_baja_solo_por": [
        503
      ],
      "nota": "ids reales de `agy models` en la cuenta AI Pro; configurable aquí. planear/verificar corren con --mode plan (solo lectura real)."
    },
    "prohibidos": [
      "gemini-2.5-pro",
      "*flash-lite*"
    ]
  },
  "limites": {
    "correcciones_max": 2,
    "informe_max_caracteres": 20000,
    "diff_max_caracteres": 200000,
    "mensaje_max_caracteres": 8000
  },
  "timeouts": {
    "planear_s": 300,
    "programar_s": 1800,
    "verificar_s": 300,
    "job_reclamado_s": 60,
    "pc_en_linea_s": 45
  },
  "requisitos": {
    "claude_modelos": [
      "opus",
      "sonnet"
    ],
    "gemini_login": "google",
    "repos_git": true
  }
}
