{
  "nota": "Modo Pro (funciona con SOLO Claude; Gemini es un extra opcional): modelos, límites y tiempos. Motor lógico \"gemini\" = Antigravity CLI (agy) con la sesión iniciada en el PC. Contrato: docs/PRO.md.",
  "local_visible": false,
  "web": {
    "nota": "Pro web: Groq traduce el pedido a un prompt tecnico; el usuario lo envia a Claude Code web o Jules. El resultado se lee por la API de GitHub (solo lectura). Jarvis nunca fusiona ni escribe en GitHub.",
    "envios_dia": 20,
    "sondeo_min_segundos": 30,
    "horas_max": 24,
    "diff_max_caracteres": 6000,
    "prompt_max_caracteres": 7000,
    "destinos": {
      "claude_web": {
        "nombre": "Claude Code (web)",
        "url": "https://claude.ai/code",
        "sitio": "claude"
      },
      "jules": {
        "nombre": "Jules",
        "url": "https://jules.google.com"
      },
      "chatgpt": {
        "nombre": "ChatGPT",
        "url": "https://chatgpt.com/",
        "sitio": "chatgpt",
        "extra": true
      },
      "grok": {
        "nombre": "Grok",
        "url": "https://grok.com/",
        "sitio": "grok",
        "extra": true
      },
      "perplexity": {
        "nombre": "Perplexity",
        "url": "https://www.perplexity.ai/",
        "sitio": "perplexity",
        "extra": true
      }
    },
    "prefijos_rama": [
      "claude/",
      "jules/",
      "google-labs-jules/",
      "codex/"
    ]
  },
  "modelos": {
    "claude": {
      "planear": "claude-opus-5-5",
      "programar": "claude-sonnet-5-5",
      "verificar": "claude-opus-5-5",
      "consultar": "claude-sonnet-5-5",
      "fallback_planear_verificar": "claude-sonnet-5-5",
      "nota": "ids exactos aceptados por la cuenta (comprobado con claude -p --model). Si Opus está saturado o sin cuota, planear/verificar los hace Sonnet 5.5 y se AVISA en el hilo (nunca en silencio)."
    },
    "gemini": {
      "planear": "gemini-3.8-flash-high",
      "verificar": "gemini-3.8-flash-high",
      "programar": [
        "gemini-3.8-flash-medium",
        "gemini-3.8-flash-low"
      ],
      "programar_baja_solo_por": [
        503
      ],
      "nota": "ids reales de `agy models` en la cuenta AI Pro; configurable aquí. planear/verificar corren con --mode plan (solo lectura real). gemini-4-hydrogen se permite pero NO aparece en agy: planea por la API (config/providers.json motores_pc.gemini.planificador)."
    },
    "prohibidos": [
      "gemini-2.5-pro",
      "*flash-lite*",
      "gemini-4-argon",
      "gemini-4-carbon",
      "gemini-3.1-pro*"
    ],
    "permitidos": [
      "gemini-4-hydrogen",
      "gemini-3.8-flash",
      "gemini-3.8-flash-*"
    ]
  },
  "limites": {
    "correcciones_max": 2,
    "informe_max_caracteres": 20000,
    "diff_max_caracteres": 200000,
    "mensaje_max_caracteres": 8000
  },
  "timeouts": {
    "planear_s": 900,
    "programar_s": 1800,
    "verificar_s": 600,
    "consultar_s": 300,
    "job_reclamado_s": 60,
    "pc_en_linea_s": 45
  },
  "coordinador": {
    "nota": "Groq (openai/gpt-oss-120b) coordina: habla con el usuario y consulta a Claude/Gemini (solo lectura). Nunca ejecuta. Sin clave o con error, vale el flujo de siempre.",
    "enabled": true,
    "max_consultas_sin_usuario": 3,
    "max_turnos_sin_usuario": 6,
    "turnos_dia": 40,
    "timeout_s": 20,
    "groq": {
      "reasoning_effort": "low",
      "max_tokens": 1500,
      "response_format": {
        "type": "json_object"
      }
    }
  },
  "requisitos": {
    "claude_modelos": [
      "claude-opus-5-5",
      "claude-sonnet-5-5"
    ],
    "gemini_login": null,
    "repos_git": true,
    "gemini_cli_min": "1.1.1"
  }
}
