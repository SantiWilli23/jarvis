# Copie este archivo como .env y rellene lo que tenga. NUNCA suba .env a git.

# Contraseña del dueño (obligatoria). Elija una larga.
OWNER_PASSWORD=
# Nombre del usuario dueño (opcional)
OWNER_NAME=señor

# Puerto local
PORT=3000

# Base de datos. Sin esto se usa el archivo local data/jarvis.db
DATABASE_URL=
DATABASE_AUTH_TOKEN=

# Claves gratis (opcionales; sin ellas funciona el proveedor de pruebas "fake")
GROQ_API_KEY=
GEMINI_API_KEY=

# Fase 3 en adelante (apagadas por ahora)
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
# Voz: Gemini TTS usa GEMINI_API_KEY; MiniMax queda apagado en config/providers.json (sin saldo)
MINIMAX_API_KEY=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# Ollama: solo se usa si responde. Lo privado solo si es localhost (p. ej. http://localhost:11434)
OLLAMA_URL=
# Puestos de pago (apagados hasta pegar clave)
OPENAI_API_KEY=
XAI_API_KEY=
PERPLEXITY_API_KEY=

# Fase 4: Telegram (los tres, o queda apagado). Chat ids separados por coma.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
# Avisos proactivos: secreto para llamar a /api/cron/tick (sin él, el cron queda apagado)
CRON_SECRET=
# Hora UTC a partir de la cual se manda el resumen diario de cuota (por defecto 12)
CRON_SUMMARY_HOUR_UTC=
# URL pública https del hub (para OAuth y el script telegram:setwebhook)
PUBLIC_URL=

# Fase 6: conectores. CONNECTIONS_KEY cifra los tokens en la BD (mínimo 16 caracteres, mejor 32 bytes en base64)
CONNECTIONS_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SPOTIFY_CLIENT_ID=
# Juego de fútbol (solo lectura). GAMES_API_TOKEN es el JWT del dueño en ese juego (opcional)
GAMES_API_URL=
GAMES_API_TOKEN=
# GitHub (solo lectura). Tokens fine-grained github_pat_, uno por cuenta/organizacion; los clasicos ghp_ se rechazan
GITHUB_TOKEN=
GITHUB_TOKENS=
# WhatsApp Cloud API (número aparte). APP_SECRET OBLIGATORIO para encender WhatsApp (firma de los webhooks)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
